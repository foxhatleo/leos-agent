{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 \"$CURSOR_PLUGIN_ROOT/scripts/cursor_hook.py\" sessionStart",
        "timeout": 10
      }
    ],
    "subagentStart": [
      {
        "command": "python3 \"$CURSOR_PLUGIN_ROOT/scripts/cursor_hook.py\" subagentStart",
        "timeout": 10
      }
    ],
    "subagentStop": [
      {
        "command": "python3 \"$CURSOR_PLUGIN_ROOT/scripts/cursor_hook.py\" subagentStop",
        "timeout": 10
      }
    ],
    "preCompact": [
      {
        "command": "python3 \"$CURSOR_PLUGIN_ROOT/scripts/cursor_hook.py\" preCompact",
        "timeout": 10
      }
    ]
  }
}

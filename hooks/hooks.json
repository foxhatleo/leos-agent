{
  "modules": ["./claude-spawn.js"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "LEOS_AGENT_HARNESS=claude python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/emit_payload.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "LEOS_AGENT_HARNESS=claude python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/dispatch_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LEOS_AGENT_HARNESS=claude python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/observe_agent.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LEOS_AGENT_HARNESS=claude python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/observe_agent.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LEOS_AGENT_HARNESS=claude python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/observe_agent.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "LEOS_AGENT_HARNESS=claude python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/link_agent.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
